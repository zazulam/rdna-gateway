# Where the lab's machines and files live. Copy to bench/lab.env and edit for your setup.

# Windows box (RX 6900 XT), reached over SSH (OpenSSH server on Windows).
DESKTOP_SSH="${DESKTOP_SSH:-you@100.64.0.10}"
DESKTOP_URL="${DESKTOP_URL:-http://100.64.0.10:8081}"
DESKTOP_ROOT="${DESKTOP_ROOT:-C:\Users\you\llama}"
DESKTOP_MODEL="${DESKTOP_MODEL:-C:\Users\you\models\gemma-4-12b-it-qat-q4_0.gguf}"

# Linux box (RX 6700 XT).
SERVER_SSH="${SERVER_SSH:-you@100.64.0.20}"
SERVER_IP="${SERVER_IP:-100.64.0.20}"
SERVER_URL="${SERVER_URL:-http://100.64.0.20:8081}"
SERVER_ROOT="${SERVER_ROOT:-~/llama}"
SERVER_MODEL="${SERVER_MODEL:-~/models/gemma-4-12b-it-qat-q4_0.gguf}"
SERVER_DEVICE="${SERVER_DEVICE:-ROCm0}"

# This Mac (M4 MacBook Air), official ggml-org macOS build.
MAC_LLAMA="${MAC_LLAMA:-$HOME/llama/llama-b11719}"
MAC_MODEL="${MAC_MODEL:-$HOME/llama/gemma-4-12b-it-qat-q4_0.gguf}"
MAC_URL="${MAC_URL:-http://127.0.0.1:8082}"

MODEL_ALIAS="${MODEL_ALIAS:-gemma4:12b}"

# Where model files live on the Windows box (lab.sh/models.sh build paths from it).
DESKTOP_MODELS="${DESKTOP_MODELS:-C:\Users\you\models}"
# The gateway the RAG benchmarks call.
GW="${GW:-http://100.64.0.10:8080}"
