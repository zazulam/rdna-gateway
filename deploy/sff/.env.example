# Address Grafana and the CPU model listen on (this box's Tailscale IP).
BIND_IP=100.64.0.20
GRAFANA_ADMIN_PASSWORD=change-me

# Scrape targets.
GATEWAY=100.64.0.10:8080
# Workers reached through the gateway's /metrics/workers/<name> relay (space-separated).
RELAYED_WORKERS=desktop-6900xt
# The GPU worker on this box: name and address.
LOCAL_WORKER=server-6700xt
LOCAL_WORKER_ADDR=127.0.0.1:8081
# Optional: a windows_exporter on another box, e.g. 100.64.0.10:9182
WINDOWS_EXPORTER=
# yes: scrape the gateway host's sensors through the gateway's /metrics/host relay
# (set "host_metrics" in gateway.json, e.g. LibreHardwareMonitor on Windows).
GATEWAY_HOST_METRICS=yes

# CPU model.
MODELS_DIR=/home/lab/models
CPU_MODEL=LFM2-8B-A1B-Q4_K_M.gguf
CPU_ALIAS=lfm2:8b
# Worker name in the gateway config and on the dashboard.
CPU_WORKER=server-cpu
CPU_THREADS=5
CPU_CTX=32768
CPU_SLOTS=2

# Retrieval. The embedder and reranker run on the GPU as systemd units
# (workers/linux/install.sh aux) on ports 8083/8084; models from bench/models.sh.
# EmbeddingGemma + bge-reranker was the best pair (docs/BENCHMARKS.md).
EMBED_MODEL_FILE=embeddinggemma-300M-Q8_0.gguf
EMBED_ALIAS=embeddinggemma-300m
EMBED_POOLING=mean
RERANK_MODEL_FILE=bge-reranker-v2-m3-Q8_0.gguf
RERANK_ALIAS=bge-reranker-v2-m3
RERANK_CANDIDATES=20
# Where the embedder and reranker run, if not on this box (e.g. a Jetson):
# EMBED_URL / RERANK_URL for the MCP server, *_ADDR for Prometheus.
EMBED_URL=
RERANK_URL=
EMBED_ADDR=
RERANK_ADDR=
# Other boxes' node_exporters to scrape: space-separated name=host:port
EXTRA_NODES=

# Secrets: up.sh fills these in on first run if they're empty. NTFY_TOPIC is
# the alert channel's name; anyone who knows it (on the tailnet) can read it.
SEARXNG_SECRET=
RDNAMCP_TOKEN=
NTFY_TOPIC=

# Energy and cost (Grafana "Energy and cost" row). Rates are your all-in
# $/kWh (delivery + supply) from a recent bill; many utilities' differ June-September.
ELECTRIC_RATE_SUMMER=
ELECTRIC_RATE_WINTER=
# Enphase IQ Gateway on the LAN; its owner token goes in secrets/envoy.token.
ENVOY_URL=https://192.168.1.50
# Power not reported by sensors (board, RAM, drives, fans), in watts, and
# power-supply efficiency. Estimates: refine with a plug-in power meter.
DESKTOP_OVERHEAD_W=45
SFF_OVERHEAD_W=20
SFF_CPU_IDLE_W=20
SFF_CPU_MAX_W=110
PSU_EFFICIENCY=0.88
JETSON_ADAPTER_EFFICIENCY=0.88
